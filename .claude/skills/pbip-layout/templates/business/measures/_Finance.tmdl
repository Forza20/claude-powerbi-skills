			)
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: Finance
		lineageTag: e3c3f0a6-e0d0-5da0-8b2e-319abcd81ba6

	measure 'Operating cash flow YoY %' =
			VAR _cur = [Operating cash flow]
			VAR _py = [Operating cash flow PY]
			RETURN
			    DIVIDE ( _cur - _py, _py )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Finance
		lineageTag: 374c8c72-1d72-5c99-b104-913e313bb198

	measure 'Operating cash flow YoY Status' =
			VAR _d = [Operating cash flow YoY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _d ), "Neutral",
			        ABS ( _d ) <= 0.005, "Neutral",
			        _d > 0, "Good",
			        "Bad"
			    )
		displayFolder: Finance
		lineageTag: dbf4fa4d-1554-5471-9ba4-7b29dd34b2b0

	measure 'Operating cash flow YoY Colour' =
			SWITCH (
			    [Operating cash flow YoY Status],
			    "Good", "#197A4C",
			    "Bad", "#C0392B",
			    "#6B7280"
			)
		displayFolder: Finance
		lineageTag: d84f1d5d-83d8-58ec-a879-80c0221e1b06

	measure 'Signed amount' =
			SUMX (
			    Fact_Finance,
			    Fact_Finance[Amount] * IF ( RELATED ( Dim_Account[AccountType] ) = "Revenue", 1, -1 )
			)
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: Finance\Base
		lineageTag: 9eec79e4-aa27-5c80-a9b2-aa586d6f311f

	partition _Finance = m
		mode: import
		source =
				let
