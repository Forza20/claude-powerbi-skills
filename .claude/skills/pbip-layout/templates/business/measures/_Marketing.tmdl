			)
		formatString: #,0
		displayFolder: Marketing
		lineageTag: ce5eff8c-8c71-5929-8ed2-af39495f2c6f

	measure 'MQLs YoY %' =
			VAR _cur = [MQLs]
			VAR _py = [MQLs PY]
			RETURN
			    DIVIDE ( _cur - _py, _py )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Marketing
		lineageTag: 3530b21d-6734-567a-bdbf-cb1858df589f

	measure 'MQLs YoY Status' =
			VAR _d = [MQLs YoY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _d ), "Neutral",
			        ABS ( _d ) <= 0.005, "Neutral",
			        _d > 0, "Good",
			        "Bad"
			    )
		displayFolder: Marketing
		lineageTag: a0367d1b-369f-5f67-bdbf-a87588467c96

	measure 'MQLs YoY Colour' =
			SWITCH (
			    [MQLs YoY Status],
			    "Good", "#197A4C",
			    "Bad", "#C0392B",
			    "#6B7280"
			)
		displayFolder: Marketing
		lineageTag: 9760e720-800e-5ced-b38a-86c426367e42

	measure SQLs = SUM ( Fact_Marketing[SQLs] )
		formatString: #,0
		displayFolder: Marketing\Base
		lineageTag: 0728269b-2c32-5b7c-8511-af331f5da686

	measure 'MQL to SQL rate' = DIVIDE ( [SQLs], [MQLs] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Marketing
		lineageTag: 4a8f2606-b181-5515-83d2-7d0045e7505b

	measure 'MQL to SQL rate PY' =
			CALCULATE (
			    [MQL to SQL rate],
			    REMOVEFILTERS ( Dim_Date ),
			    SAMEPERIODLASTYEAR ( Dim_Date[Date] )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Marketing
		lineageTag: a833efd4-9c30-5b26-88f1-811ade448e95

	measure 'MQL to SQL rate YoY pp' =
			VAR _cur = [MQL to SQL rate]
			VAR _py = [MQL to SQL rate PY]
			RETURN
			    IF ( NOT ISBLANK ( _cur ) && NOT ISBLANK ( _py ), ( _cur - _py ) * 100 )
		formatString: +0.0 \p\p;-0.0 \p\p;0.0 \p\p
		displayFolder: Marketing
		lineageTag: d1814aeb-c114-5f6b-85bb-c74163884f41

	measure 'MQL to SQL rate YoY Status' =
			VAR _d = [MQL to SQL rate YoY pp]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _d ), "Neutral",
			        ABS ( _d ) <= 0.5, "Neutral",
			        _d > 0, "Good",
			        "Bad"
			    )
		displayFolder: Marketing
		lineageTag: e38f1c49-1df1-5045-96fe-52b9c781c88e

	measure 'MQL to SQL rate YoY Colour' =
			SWITCH (
			    [MQL to SQL rate YoY Status],
			    "Good", "#197A4C",
			    "Bad", "#C0392B",
			    "#6B7280"
			)
		displayFolder: Marketing
		lineageTag: 3c12ea10-e4b0-502f-a809-d7db59c07c2f

	measure Spend = SUM ( Fact_Marketing[Spend] )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: Marketing
		lineageTag: f9b854bc-6715-5c69-a0c0-ff13b3c735db

	measure 'Spend PY' =
			CALCULATE (
			    [Spend],
			    REMOVEFILTERS ( Dim_Date ),
