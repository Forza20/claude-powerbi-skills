		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Marketing
		lineageTag: d37064dd-971f-5b56-b334-0439d656dbd7

	measure 'Spend YoY Status' = "Neutral"
		displayFolder: Marketing
