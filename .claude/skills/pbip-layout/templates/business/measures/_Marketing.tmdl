			SWITCH (
			    [CPL YoY Status],
			    "Good", "#197A4C",
			    "Bad", "#C0392B",
			    "#6B7280"
			)
		displayFolder: Marketing
		lineageTag: 80323ba6-12d8-5c21-b9aa-1d9718783629

	measure Conversions = SUM ( Fact_Marketing[Conversions] )
		formatString: #,0
		displayFolder: Marketing\Base
		lineageTag: 22ca41cd-1f5e-5cf4-b520-f8717d6e550b

	measure 'Attributed revenue' = SUM ( Fact_Marketing[AttributedRevenue] )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: Marketing\Base
		lineageTag: 4dbef7d5-0f56-5312-8bbf-568aedd1deac

	measure 'Marketing ROI %' =
			VAR _spend = [Spend]
			RETURN
			    DIVIDE ( [Attributed revenue] - _spend, _spend )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Marketing
		lineageTag: 82affeb2-0f96-5a6d-a9b0-9f3bab4497a8

	measure 'Marketing ROI % PY' =
			CALCULATE (
			    [Marketing ROI %],
			    REMOVEFILTERS ( Dim_Date ),
			    SAMEPERIODLASTYEAR ( Dim_Date[Date] )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Marketing
		lineageTag: c1c57d9f-47ff-5270-be1f-ace4d4388294

	measure 'Marketing ROI % YoY pp' =
			VAR _cur = [Marketing ROI %]
			VAR _py = [Marketing ROI % PY]
			RETURN
			    IF ( NOT ISBLANK ( _cur ) && NOT ISBLANK ( _py ), ( _cur - _py ) * 100 )
		formatString: +0.0 \p\p;-0.0 \p\p;0.0 \p\p
		displayFolder: Marketing
		lineageTag: 2c33a12b-f702-55aa-93e4-d9f927e63353

	measure 'Marketing ROI % YoY Status' =
			VAR _d = [Marketing ROI % YoY pp]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _d ), "Neutral",
			        ABS ( _d ) <= 0.5, "Neutral",
			        _d > 0, "Good",
			        "Bad"
			    )
		displayFolder: Marketing
		lineageTag: 9a50ab91-bc66-5344-9d18-9b48680afcb1

	measure 'Marketing ROI % YoY Colour' =
			SWITCH (
			    [Marketing ROI % YoY Status],
			    "Good", "#197A4C",
			    "Bad", "#C0392B",
			    "#6B7280"
			)
		displayFolder: Marketing
		lineageTag: 957f04d9-2a67-5581-8afb-f1d081efed31

	measure Engagements = SUM ( Fact_Marketing[Engagements] )
		formatString: #,0
		displayFolder: Marketing\Base
		lineageTag: 0ff66da2-9106-52c6-811a-162f5b71878c

	measure Downloads = SUM ( Fact_Marketing[Downloads] )
		formatString: #,0
		displayFolder: Marketing\Base
		lineageTag: bf6531ac-e2f1-5c52-90c3-a1449b9921ce

	measure 'Funnel value' =
			VAR _stage = SELECTEDVALUE ( Dim_FunnelStage[Stage] )
			RETURN
			    SWITCH (
			        _stage,
			        "Leads", [Leads],
			        "MQLs", [MQLs],
			        "SQLs", [SQLs],
			        "Conversions", [Conversions]
			    )
		formatString: #,0
		displayFolder: Marketing\Base
		lineageTag: 49575233-4eb9-53ce-84c5-6605f91a62f4

