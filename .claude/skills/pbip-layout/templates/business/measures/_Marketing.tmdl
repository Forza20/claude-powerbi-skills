			    REMOVEFILTERS ( Dim_Date ),
			    SAMEPERIODLASTYEAR ( Dim_Date[Date] )
			)
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: Marketing
		lineageTag: 66456eaf-0023-5977-a6cf-e691125e6dcc

	measure 'CPL YoY %' =
			VAR _cur = [CPL]
			VAR _py = [CPL PY]
			RETURN
			    DIVIDE ( _cur - _py, _py )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Marketing
		lineageTag: 2c2ce8ee-15d7-51d6-a76d-e12f808ae77e

	measure 'CPL YoY Status' =
			VAR _d = [CPL YoY %]
			RETURN
			    SWITCH (
