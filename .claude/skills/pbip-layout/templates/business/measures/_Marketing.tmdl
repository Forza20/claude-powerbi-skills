table _Marketing
	lineageTag: d97b9d0e-18e6-5c2b-87fd-37841e9f5d30

	column Placeholder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ea8a8d39-3fd4-52de-be63-8e82ae575e90
		summarizeBy: none
		sourceColumn: Placeholder

	measure Leads = SUM ( Fact_Marketing[Leads] )
		formatString: #,0
		displayFolder: Marketing
		lineageTag: 3dc16107-a16d-5198-bd8d-85d62ad6e5d9

	measure 'Leads PY' =
			CALCULATE (
			    [Leads],
			    REMOVEFILTERS ( Dim_Date ),
			    SAMEPERIODLASTYEAR ( Dim_Date[Date] )
			)
		formatString: #,0
		displayFolder: Marketing
		lineageTag: f851ffcc-f698-5879-8ff4-392c2b6cbeff

	measure 'Leads YoY %' =
			VAR _cur = [Leads]
			VAR _py = [Leads PY]
			RETURN
			    DIVIDE ( _cur - _py, _py )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Marketing
		lineageTag: d7a246df-4db9-5d12-813b-d92f09388173

	measure 'Leads YoY Status' =
			VAR _d = [Leads YoY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _d ), "Neutral",
			        ABS ( _d ) <= 0.005, "Neutral",
			        _d > 0, "Good",
			        "Bad"
			    )
		displayFolder: Marketing
		lineageTag: 287ee15f-73e2-5ee9-9df8-3b7cc8c8f6ed

	measure 'Leads YoY Colour' =
			SWITCH (
			    [Leads YoY Status],
			    "Good", "#197A4C",
			    "Bad", "#C0392B",
			    "#6B7280"
			)
		displayFolder: Marketing
		lineageTag: cceeb363-c61f-55f4-a5f4-3d939fc2b24c

	measure MQLs = SUM ( Fact_Marketing[MQLs] )
		formatString: #,0
		displayFolder: Marketing
		lineageTag: c53077bf-48f8-5ff1-abe8-496754633ec9

	measure 'MQLs PY' =
			CALCULATE (
			    [MQLs],
