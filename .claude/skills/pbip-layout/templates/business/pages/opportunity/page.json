{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "OpportunityDetail",
  "displayName": "Opportunity Detail",
  "displayOption": "FitToPage",
  "height": 720,
  "width": 1280,
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'{{canvas}}'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ]
  },
  "type": "Drillthrough",
  "visibility": "HiddenInViewMode",
  "pageBinding": {
    "name": "DrillOpportunity",
    "type": "Drillthrough",
    "referenceScope": "Default",
    "parameters": [
      {
        "name": "Param_Rep",
        "boundFilter": "f_rep",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Rep"
              }
            },
            "Property": "Rep"
          }
        }
      },
      {
        "name": "Param_Customer",
        "boundFilter": "f_customer",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Customer"
              }
            },
            "Property": "CustomerName"
          }
        }
      }
    ],
    "acceptsFilterContext": "Default"
  },
  "filterConfig": {
    "filters": [
      {
        "name": "f_rep",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Rep"
              }
            },
            "Property": "Rep"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      },
      {
        "name": "f_customer",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Customer"
              }
            },
            "Property": "CustomerName"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      }
    ]
  }
}
