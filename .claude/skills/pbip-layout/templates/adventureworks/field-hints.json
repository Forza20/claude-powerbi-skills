{
 "_about": "Name patterns per template field for scripts/suggest-fields.js. Names are compared lower case with every non-letter/digit as _ (Total Sales -> total_sales). 'table' limits columns to matching tables ('date' = the marked date table, 'measures' = any measure). 'names' are tried in order, then 'fallback' (layout.md's fallback; the suggestion says so). 'make' names the measures.md recipe when nothing matches.",
 "Measure Table[Total Revenue]": { "names": ["^total_?revenue$", "^revenue$", "^total_?sales$", "^sales$", "^net_?sales$", "^sales_?amount$", "^turnover$", "^omsaetning$"] },
 "Measure Table[Total Orders]": { "names": ["^total_?orders$", "^orders$", "^order_?count$", "^number_of_orders$", "^ordrer$"], "fallback": ["^transactions$", "^rows$", "^lines$"] },
 "Measure Table[Total Profit]": { "names": ["^total_?profit$", "^profit$", "^gross_?margin$", "^gross_?profit$", "^margin$", "^daekningsbidrag$"], "fallback": ["^net_?sales$"] },
 "Measure Table[Return Rate]": { "names": ["^return_?rate$", "^returns?_?pct$", "^churn_?rate$", "^cancellation_?rate$"], "fallback": ["^gross_?margin_?pct$", "^margin_?pct$", "^profit_?margin$"], "decision": "a fallback here is high = good: ask about reverseScales and the texts" },
 "Measure Table[Total Returns]": { "names": ["^total_?returns$", "^returns$", "^returned$", "^complaints$"], "fallback": ["^customers$", "^total_?customers$", "^active_?customers$"], "decision": "a fallback changes 'Monthly Returns' – set texts" },
 "Measure Table[Total Customers]": { "names": ["^total_?customers$", "^customers$", "^customer_?count$", "^active_?customers$", "^kunder$"] },
 "Measure Table[Previous Month Revenue]": { "names": ["^previous_?month_?(revenue|sales)$", "^(revenue|sales)_?(pm|previous_?month|last_?month)$"], "make": "previous month" },
 "Measure Table[Previous Month Orders]": { "names": ["^previous_?month_?orders$", "^orders_?(pm|previous_?month|last_?month)$"], "make": "previous month" },
 "Measure Table[Previous Month Returns]": { "names": ["^previous_?month_?(returns|customers)$", "^(returns|customers)_?(pm|previous_?month|last_?month)$"], "make": "previous month (of the measure mapped to Total Returns)" },
 "Measure Table[Revenue Target]": { "names": ["^(revenue|sales)_?target$", "^target_?(revenue|sales)$", "^budget$", "^sales_?budget$"], "make": "targets" },
 "Measure Table[Order Target]": { "names": ["^orders?_?target$", "^target_?orders$"], "make": "targets" },
 "Measure Table[Profit Target]": { "names": ["^(profit|margin|gross_?margin)_?target$", "^target_?(profit|margin)$"], "make": "targets" },
 "Measure Table[Revenue Target Gap]": { "names": ["^(revenue|sales)_?target_?gap$", "^(revenue|sales)_?vs_?target$"], "make": "targets" },
 "Measure Table[Order Target Gap]": { "names": ["^orders?_?target_?gap$"], "make": "targets" },
 "Measure Table[Profit Target Gap]": { "names": ["^(profit|margin|gross_?margin)_?target_?gap$"], "make": "targets" },
 "Measure Table[Adjusted Profit]": { "names": ["^adjusted_?(profit|gross_?margin|margin)$"], "make": "price adjustment" },
 "Measure Table[Average Revenue per Customer]": { "names": ["^average_?(revenue|sales)_?per_?customer$", "^(revenue|sales)_?per_?customer$"], "make": "customers" },
 "Measure Table[Average Retail Price]": { "names": ["^average_?(retail_?)?price$", "^avg_?price$"], "fallback": ["^average_?order_?value$", "^aov$", "^average_?list_?price$"] },
 "Calendar Lookup[Date]": { "table": "date", "names": ["^date$", "^dato$"] },
 "Calendar Lookup[Year]": { "table": "date", "names": ["^year$", "^aar$"] },
 "Calendar Lookup[Month]": { "table": "date", "names": ["^month$", "^month_?name$", "^maaned$"] },
 "Calendar Lookup[Start of Month]": { "table": "date", "names": ["^start_?of_?month$", "^month_?start$", "^monthstart$"] },
 "Calendar Lookup[Start of Week]": { "table": "date", "names": ["^start_?of_?week$", "^week_?start$"] },
 "Calendar Lookup[Start of Quarter]": { "table": "date", "names": ["^start_?of_?quarter$", "^quarter_?start$"] },
 "Calendar Lookup[Date Hierarchy.Date]": { "table": "date", "names": ["^date$"] },
 "Calendar Lookup[Date Hierarchy.Year]": { "table": "date", "names": ["^year$"] },
 "Calendar Lookup[Date Hierarchy.Start of Month]": { "table": "date", "names": ["^start_?of_?month$", "^month_?start$"] },
 "Calendar Lookup[Date Hierarchy.Start of Week]": { "table": "date", "names": ["^start_?of_?week$", "^week_?start$"] },
 "Product Categories Lookup[CategoryName]": { "table": "product|item|article|vare", "names": ["^category(_?name)?$", "^product_?category$", "^kategori$"], "fallback": ["^segment$", "^channel$"] },
 "Product Subcategories Lookup[SubcategoryName]": { "table": "product|item|article|vare", "names": ["^sub_?category(_?name)?$", "^product_?subcategory$"], "fallback": ["^brand$", "^category$"] },
 "Product Lookup[ProductName]": { "table": "product|item|article|vare", "names": ["^product_?name$", "^name$", "^product$", "^item_?name$"] },
 "Product Lookup[ProductColor]": { "table": "product|item|article|vare", "names": ["^product_?colou?r$", "^colou?r$"], "fallback": ["^brand$", "^size$", "^supplier$", "^primary_?supplier$"] },
 "Product Lookup[ProductCost]": { "table": "product|item|article|vare", "names": ["^product_?cost$", "^unit_?cost$", "^cost$"], "fallback": ["^list_?price$", "^price$", "^unit_?price$"] },
 "Territory Lookup[Country]": { "table": "territor|geo|country|city|region|location|customer|store", "names": ["^country(_?name)?$", "^land$"], "fallback": ["^city$", "^city_?name$", "^state$"] },
 "Territory Lookup[Continent]": { "table": "territor|geo|country|city|region|location|customer|store", "names": ["^continent$", "^region$", "^sales_?region$"], "fallback": ["^country$"] },
 "Customer Lookup[CustomerKey]": { "table": "customer|client|kunde", "names": ["^customer_?id$", "^customer_?key$", "^customer_?number$", "^id$"] },
 "Customer Lookup[Full Name]": { "table": "customer|client|kunde", "names": ["^full_?name$", "^customer_?name$", "^name$", "^company$"] },
 "Customer Lookup[Income Level]": { "table": "customer|client|kunde", "names": ["^income_?level$", "^segment$", "^customer_?segment$"], "fallback": ["^region$", "^payment_?terms$"] },
 "Customer Lookup[Occupation]": { "table": "customer|client|kunde", "names": ["^occupation$", "^industry$", "^region$"], "fallback": ["^city$", "^country$"] },
 "Customer Lookup[HomeOwner]": { "table": "customer|client|kunde", "names": ["^home_?owner$", "^segment$"], "fallback": ["^payment_?terms$"] },
 "Customer Lookup[AnnualIncome]": { "table": "customer|client|kunde", "names": ["^annual_?income$", "^income$", "^credit_?limit$"] },
 "Customer Lookup[EducationLevel]": { "table": "customer|client|kunde", "names": ["^education(_?level)?$", "^payment_?terms$"] },
 "Customer Lookup[Is Parent?]": { "table": "customer|client|kunde", "names": ["^is_?parent$", "^has_?children$"] },
 "Customer Lookup[MaritalStatus]": { "table": "customer|client|kunde", "names": ["^marital_?status$"] },
 "Customer Metric Selection[Customer Metric Selection]": { "table": "customer_?metric_?selection", "names": ["^customer_?metric_?selection$"], "make": "field parameters" },
 "Customer Metric Selection[Customer Metric Selection Fields]": { "table": "customer_?metric_?selection", "names": ["^customer_?metric_?selection_?fields$"], "make": "field parameters" },
 "Product Metric Selection[Product Metric Selection]": { "table": "product_?metric_?selection", "names": ["^product_?metric_?selection$"], "make": "field parameters" },
 "Product Metric Selection[Product Metric Selection Fields]": { "table": "product_?metric_?selection", "names": ["^product_?metric_?selection_?fields$"], "make": "field parameters" },
 "Price Adjustment (%)[Price Adjustment (%)]": { "table": "price_?adjustment", "names": ["^price_?adjustment(_?pct)?$"], "make": "price adjustment" }
}
